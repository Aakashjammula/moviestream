# Copy to .env and fill in your values. NEVER commit .env.
#   cp .env.example .env

# Where your media lives, split in two so an unplugged USB drive is handled cleanly:
#   MEDIA_ROOT   - the folder your drive gets mounted IN (always exists), e.g. /run/media/you
#   MEDIA_SUBDIR - the media folder on the drive, relative to MEDIA_ROOT
# Example for /run/media/you/Expansion/movies/data:
MEDIA_ROOT=/run/media/you
MEDIA_SUBDIR=Expansion/movies/data

# Bcrypt hash of your login password. Generate with:
#   docker compose run --rm backend python3 -c \
#     "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
# Then paste the output after APP_PASSWORD_HASH=
APP_PASSWORD_HASH=

# TMDB API key (free at https://www.themoviedb.org/settings/api).
# Used for posters, backdrops, overviews, genres, original language.
TMDB_API_KEY=

# Cloudflare Tunnel token (Cloudflare dashboard -> Networks -> Tunnels).
# Public hostname in the tunnel: movies-api.aakashjammula.com -> http://backend:8000
TUNNEL_TOKEN=

# Where the UI is served from (comma-separated). The browser's login cookie and API
# calls are only accepted from these origins.
FRONTEND_ORIGINS=https://movies.aakashjammula.com,http://localhost:3000

# OpenSubtitles credentials (optional, improves subtitle matching).
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
