# Copy to .env and fill in your values. NEVER commit .env.
#   cp .env.example .env

# Absolute path to your media folder (movies + TV shows, any nesting).
# Example: /run/media/you/Expansion/movies/data  or  /mnt/media
MEDIA_DIR=/path/to/your/media

# Bcrypt hash of your login password. Generate with:
#   docker compose run --rm backend python3 -c \
#     "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
# Then paste the output after APP_PASSWORD_HASH=
APP_PASSWORD_HASH=

# TMDB API key (free at https://www.themoviedb.org/settings/api).
# Used for posters, backdrops, overviews, genres, original language.
TMDB_API_KEY=

# Cloudflare Tunnel token (Cloudflare dashboard -> Networks -> Tunnels).
# Leave empty to skip the cloudflared service (local-only use).
TUNNEL_TOKEN=

# OpenSubtitles credentials (optional, improves subtitle matching).
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
